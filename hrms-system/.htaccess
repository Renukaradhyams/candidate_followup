# ==============================================================================
# BSC Enterprise HRMS - Hostinger Apache & LiteSpeed Configuration (.htaccess)
# ==============================================================================

# Explicitly set Directory Index files so Apache never attempts directory listing 403s
DirectoryIndex index.html index.js index.php

# Options & Security Settings
Options -Indexes +SymLinksIfOwnerMatch

# Explicitly Allow All Access (Fixes Apache 403 'Access to this resource on the server is denied!')
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>

# Disable ModSecurity WAF & Hostinger Bot Verification False Positives
<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>
<IfModule mod_security2.c>
    SecRuleEngine Off
    SecRequestBodyAccess Off
</IfModule>

# LiteSpeed Web Server Tuning: Prevent premature timeouts (408) and process aborts
<IfModule LiteSpeed>
    CacheLookup off
    SetEnv verifycaptcha off
    RewriteEngine On
    RewriteRule .* - [E=noabort:1,E=noconntimeout:1]
</IfModule>

# Enable CGI Authorization Pass-Through & React SPA Fallback Rewriting (Fixes 404 on page refresh)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule .* - [E=noabort:1,E=noconntimeout:1]

    # Cleanly return 200 OK for HTTP OPTIONS Preflight CORS requests from mobile browsers
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule .* - [R=200,L]

    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    # Map static assets to dist/assets if not found at root
    RewriteCond %{REQUEST_URI} ^/assets/
    RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
    RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

    # Map uploads to hrms-system/uploads if physically present there
    RewriteCond %{REQUEST_URI} ^/uploads/(.*)$
    RewriteCond %{DOCUMENT_ROOT}/hrms-system/uploads/%1 -f
    RewriteRule ^uploads/(.*)$ hrms-system/uploads/$1 [L]

    # Serve existing physical files or folders directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Exclude API and server status endpoints from SPA rewrite
    RewriteCond %{REQUEST_URI} !^/(api|health|db-status) [NC]

    # Fallback all client SPA routes (e.g. /login, /candidates, /candidate-entry) to dist/index.html or index.html
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^ index.html [L]
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteRule ^ dist/index.html [L]
    RewriteCond %{DOCUMENT_ROOT}/hrms-system/dist/index.html -f
    RewriteRule ^ dist/index.html [L]
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_env.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    CGIPassAuth On
</IfModule>

# Passenger Configuration for Hostinger Node.js Application
<IfModule mod_passenger.c>
    PassengerStartupFile index.js
    PassengerAppType node
    PassengerEnabled on
</IfModule>

# Allow Static Upload & Asset Access (Photos, Resumes, Documents, JS, CSS, PWA Manifest, SW)
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|pdf|doc|docx|js|css|woff2?|ico|json|webmanifest)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>
    <FilesMatch "(sw\.js|manifest\.json)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Service-Worker-Allowed "/"
    </FilesMatch>
    # Security Headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
