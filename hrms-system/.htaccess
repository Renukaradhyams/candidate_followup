# ==============================================================================
# BSC Enterprise HRMS - Hostinger Apache & Passenger Configuration (.htaccess)
# ==============================================================================

# Explicitly set Directory Index files so Apache never attempts directory listing 403s
DirectoryIndex index.html index.js index.php

# Options & Security Settings
Options -Indexes +SymLinksIfOwnerMatch

# Explicitly Allow All Access (Fixes Apache 403 'Access to this resource on the server is denied!')
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>

# Disable ModSecurity WAF & Hostinger Bot Verification False Positives
<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>

# Disable LiteSpeed Web Server Anti-Bot / Anti-DDoS Challenge Filters for App Routes
<IfModule LiteSpeed>
    CacheLookup off
</IfModule>

# Enable CGI Authorization Pass-Through & React SPA Fallback Rewriting (Fixes 404 on page refresh)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    # Serve existing physical files or folders directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Exclude API, Uploads, Assets, and static files from SPA rewrite
    RewriteCond %{REQUEST_URI} !^/(api|uploads|assets|health|db-status) [NC]
    RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|ico|svg|pdf|doc|docx|woff|woff2)$ [NC]

    # Fallback all client SPA routes (e.g. /login, /candidates, /candidate-entry) to index.html
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_env.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    CGIPassAuth On
</IfModule>

# Passenger Configuration for Hostinger Node.js Application
<IfModule mod_passenger.c>
    PassengerStartupFile index.js
    PassengerAppType node
    PassengerEnabled on
</IfModule>

# Allow Static Upload & Asset Access (Photos, Resumes, Documents, JS, CSS)
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|pdf|doc|docx|js|css|woff2?|ico)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>
    # Security Headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>



