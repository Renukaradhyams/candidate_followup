{
  "name": "hrms-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cd client && npm run dev",
    "build": "cd client && npm install --legacy-peer-deps && npm run build && node -e \"const fs = require('fs'); const src = fs.existsSync('out') ? 'out' : '.next'; if (!fs.existsSync('../dist')) fs.cpSync(src, '../dist', {recursive: true}); if (!fs.existsSync('dist')) fs.cpSync(src, 'dist', {recursive: true});\"",
    "start": "cd server && npm start"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "express": "^4.19.2",
    "mysql2": "^3.10.1",
    "tailwindcss": "^3.4.10",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "latest",
    "lucide-react": "^0.436.0",
    "recharts": "^3.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2",
    "typescript": "^5.5.4",
    "@types/node": "^20.16.1",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0"
  },
  "overrides": {
    "tar": "latest",
    "next": "latest",
    "postcss": "latest",
    "multer": "latest",
    "recharts": "latest",
    "rimraf": "latest",
    "glob": "latest"
  }
}